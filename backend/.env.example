APP_NAME=MarketWorld
NODE_ENV=development
PORT=4000
WEB_PORT=5173
API_PREFIX=/api/v1
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=600
SOCKET_PATH=/socket.io
DATABASE_URL=postgresql://marketworld:change_me@localhost:5432/marketworld
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
JWT_ISSUER=marketworld-api
JWT_AUDIENCE=marketworld-web
JWT_ACCESS_SECRET=replace_with_a_secure_32_plus_character_secret
JWT_REFRESH_SECRET=replace_with_a_secure_32_plus_character_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
REFRESH_COOKIE_NAME=mw_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SPLIT_CODE=
PAYSTACK_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TRIAL_ENABLED=true
TRIAL_DAYS=30
TRIAL_PLAN_NAME=Trial
ADMIN_PREMIUM_OVERRIDE_ENABLED=false
ADMIN_PREMIUM_EMAILS=
ADMIN_PREMIUM_USER_IDS=
ADMIN_PREMIUM_PLAN_NAME=
